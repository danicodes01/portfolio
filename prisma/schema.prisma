generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Project {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  
  // Localized content fields
  summary       String
  summaryEs     String?    @map("summary_es")
  summaryDe     String?    @map("summary_de")
  summaryFr     String?    @map("summary_fr")
  summaryZh     String?    @map("summary_zh")
  summaryAr     String?    @map("summary_ar") 
  summaryJa     String?    @map("summary_ja")
  summaryRu     String?    @map("summary_ru")
  info          String
  infoEs        String?    @map("info_es")
  infoDe        String?    @map("info_de")
  infoFr        String?    @map("info_fr")
  infoZh        String?    @map("info_zh") 
  infoAr        String?    @map("info_ar")
  infoJa        String?    @map("info_ja")
  infoRu        String?    @map("info_ru")
  
  link          String
  repo          String
  media         String[]
  date          DateTime
}