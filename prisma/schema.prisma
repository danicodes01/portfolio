generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Project {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  
  // Localized content fields
  summary       String
  summaryEs     String?    @map("summary_es")
  summaryDe     String?    @map("summary_de")
  summaryFr     String?    @map("summary_fr")
  
  info          String
  infoEs        String?    @map("info_es")
  infoDe        String?    @map("info_de")
  infoFr        String?    @map("info_fr")
  
  link          String
  repo          String
  media         String[]
  
  date          DateTime
}